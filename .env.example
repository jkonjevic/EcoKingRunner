# EcoKing site credentials -- required.
url=https://example.com
email=your-email@gmail.com
password=your-password

# Web UI ---------------------------------------------------------------------
# Set APP_PASSWORD whenever the UI is reachable from the internet. Without it,
# anyone with the URL can start a run.
# APP_PASSWORD=
# HOST=127.0.0.1
# PORT=8765
# ECOKING_MODE=cloud     # forces cloud behaviour: no Desktop copy, no Excel open
# DATA_DIR=./data        # where reports, logs and devices.json are kept

# Browser --------------------------------------------------------------------
HEADLESS=false
SLOW_MO_MS=0
CHART_WAIT_MS=5000
SEARCH_RESULTS_WAIT_MS=2000
WORKERS=1
KEEP_BROWSER_OPEN=false
CONTINUE_ON_ERROR=true
VERBOSE=true
# CHROME_PATH=/usr/bin/google-chrome

# Files ----------------------------------------------------------------------
# TEMPLATE_PATH=ECO KING BLANKO TABLICA.xlsx
# STATIONS_PATH=stations.json
# COPY_REPORT_TO_DESKTOP=true

# Selector overrides ---------------------------------------------------------
# Fill these in after watching a headed run, if the EcoKing UI changes and the
# built-in fallbacks stop finding an element.
# LOGIN_EMAIL_SELECTOR=input[type="email"]
# LOGIN_PASSWORD_SELECTOR=input[type="password"]
# LOGIN_SUBMIT_SELECTOR=button[type="submit"]
# WAIT_FOR_LOGIN_SECONDS=0
#
# Top-left blue device dropdown button on the Home page.
# SEARCH_TOGGLE_SELECTOR=.content-header button.btn-primary
# SEARCH_INPUT_SELECTOR=input[type="search"]
# SEARCH_INPUT_WAIT_MS=500
# SEARCH_TYPE_DELAY_MS=10
#
# INTERVAL_SELECTOR=select
# INTERVAL_1_DAY_LABEL=1 Day (15-minutely)
# INTERVAL_30_DAYS_LABEL=30 days
# CHART_CONTAINER_SELECTOR=.chart-container
# DATA_TABLE_SELECTOR=table
#
# Website date values are always entered as DD/MM/YYYY (for example 21/07/2026).
# WEBSITE_DATE_PICKER_SELECTOR=button[title="Choose Date..."]
# WEBSITE_DATE_DIALOG_SELECTOR=[role="dialog"]
# WEBSITE_DATE_INPUT_SELECTOR=input[value*="/"]
# WEBSITE_DATE_PREV_SELECTOR=button[aria-label*="Previous"]
# WEBSITE_DATE_NEXT_SELECTOR=button[aria-label*="Next"]
# WEBSITE_DATE_DAY_SELECTOR=button
# WEBSITE_DATE_OK_SELECTOR=button:has-text("OK")
#
# BATTERY_SELECTOR=span[uib-tooltip="Battery level"]
# BATTERY_WAIT_MS=5000
